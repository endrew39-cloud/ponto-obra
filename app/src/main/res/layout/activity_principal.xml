<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Escolha a Obra">
        <com.google.android.material.textfield.TextInputAutoCompleteTextView
            android:id="@+id/listaObras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEntrada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="✅ Registrar Entrada"
        android:backgroundTint="#2E7D32"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaida"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="⏹️ Registrar Saída"
        android:backgroundTint="#C62828"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCadastrarObra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="📍 Cadastrar Nova Obra"
        android:backgroundTint="#1565C0"/>
</LinearLayout>
